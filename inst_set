;        Stack Instruction Set                   s.sm

         ;===================================================
         ; Fetch machine instruction, increment pc
fetch:   a.pc c.mar 
         a.pc add b.1 c.pc rd

         ;===================================================
         ; Decode instruction
         
; How to proceed:
; 1) Analyze the first bit by adding 0 to it. If the n (negative) flag is 1, set the 1st bit to 1 and jump to L1; else execute the next instruction;
; 2) Shift left logically by 1 bit the next bit in the opcode from the instruction register;
; 3) Analyze the shifted out bit. If it's 1, set the bit to 1 and jump to the next label; else execute the next instruction;
; 4) Repeat steps 2 and 3 until the analysis of all 4 bits is complete.
; We are done: all 4 bits are decoded, we can now execute the appropriate machine instruction.

         a.mdr add b.0 c.ir neg@L1
L0:      a.ir sll b.1 c.dc neg@L01
L00:     a.dc sll b.1 c.dc neg@L001
L000:    a.dc sll b.1 c.dc neg@L0001
         br@L0000

L1:      a.ir sll b.1 c.dc neg@L11
L10:     a.dc sll b.1 c.dc neg@L101
L100:    a.dc sll b.1 c.dc neg@L1001
         br@L1000

L01:     a.dc sll b.1 c.dc neg@L011
L010:    a.dc sll b.1 c.dc neg@L0101
         br@L0100

L11:     a.dc sll b.1 c.dc neg@L111
L110:    a.dc sll b.1 c.dc neg@L1101
         br@L1100

L001:    a.dc sll b.1 c.dc neg@L0011
         br@L0010

L011:    a.dc sll b.1 c.dc neg@L0111
         br@L0110

L101:    a.dc sll b.1 c.dc neg@L1011
         br@L1010

L111:    a.dc sll b.1 c.dc neg@L1111
         br@L1110

         ;===================================================
         ; Interpret machine instruction
         
L0000:   ; p (push) ================================================
         a.ir and b.m12 c.mar    ; Get the relative address
         rd                      ; Read the data at the address
         a.sp sub b.1 c.sp       ; Reserve space for data
         a.sp c.mar              ; Send the stack top's address to mar
         wr                      ; Write the data to memory
         a.mdr c.mar br@fetch    ; Push the value on top of stack

L0001:   ; pi (push immediate) ===============================================
         a.ir and b.m12 c.mar    ; Get the immediate value inside the instruction
         a.mar c.mdr             ; Place the value in mdr
         a.sp sub b.1 c.sp       ; Reserve space for data
         a.sp c.mar              ; Send the stack top's address to mar
         wr                      ; Write the data to memory
         a.mdr c.mar br@fetch    ; Push immediate value/address onto the stack
          
L0010:   ; pr (push relative) ===============================================
         a.ir sext b.m12 c.mar    ; Get the relative address
         a.mar c.mdr              ; Store the address in mdr
         a.fp add b.mdr c.mdr     ; Update the address in mdr so it has the location relative to the frame pointer
         a.mdr c.mar              ; Send the updated address to mar
         rd                       ; Read the data
         a.sp sub b.1 c.sp        ; Reserve space for data
         a.sp c.mar               ; Get the top of stack
         wr br@fetch		  ; Write data to the reserved space

L0011:   ; cora (convert relative address) =============================================
         a.ir sext b.m12 c.mar    ; Get the relative address
         a.mar c.mdr              ; Store the relative address in mdr
         a.fp add b.mdr c.mdr     ; Convert to absolute address by adding frame pointer and address in mdr
         a.mdr c.mar              ; Place the absolute address in mar, this will get us the data the absolute address contains
         a.sp sub b.1 c.sp        ; Reserve space for data
         a.sp c.mar               ; Read the top of stack
         wr br@fetch		  ; Write the data to memory

L0100:   ; stav (store value at address) =============================================
         a.sp c.mar             ; Read the value on top of stack
         a.sp add b.1 c.sp rd   ; Pop the top of stack and read the data into mdr for safekeeping
         a.mdr c.temp		; Save the value into temp
         a.sp c.mar             ; Get the top of stack's address
         a.sp add b.1 c.sp rd 	; Pop the top of stack again and read the address into mdr
         a.mdr c.mar		; Place the address into mar
         a.temp c.mdr           ; Move the value to store into mdr
         wr br@fetch		; Write the data at the specified memory location
         
L0101:   ; dp (dereference pointer) ===============================================
         a.sp c.mar	; Place the pointer's address into mar
         rd		; Get the address the pointer references
         a.mdr c.mar	; Place the pointee's address into mar
         rd		; Read the pointee's data
         a.sp c.mar	; Get the top of stack's address
         wr br@fetch	; Rewrite the pointer with the data it references

L0110:   ; asp (add to stack pointer) ==============================================
         a.ir sext b.m12 c.mar           ; Get the whole instruction
         a.mar c.mdr                     ; Get the immediate value
         a.sp add b.mdr c.sp br@fetch    ; Reserve (if the value is negative) or return (if the value is positive) space on the stack
          
L0111:   ; add ==============================================
         a.sp c.mar             ; Get the top of stack's address
         a.sp add b.1 c.sp rd   ; Read the first operand and pop the stack
         a.mdr c.temp           ; Save the first operand
         a.sp c.mar             ; Get the top of stack's address
         rd			; Read the second operand
         a.mdr add b.temp c.mdr	; Add two operands
         wr br@fetch		; Rewrite the top of stack with a new value

L1000:   ; sub (subtract) ==============================================
         a.sp c.mar             ; Get the top of stack's address
         a.sp add b.1 c.sp rd   ; Read the first operand and pop the stack
         a.mdr c.temp           ; Save the first operand
         a.sp c.mar             ; Get the top of stack's address
         rd			; Read the second operand
         a.mdr sub b.temp c.mdr ; Subtract two operands
         wr br@fetch		; Rewrite the top of stack with a new value

L1001:   ; call =============================================
         a.sp sub b.1 c.sp                  ; Reserve space for a value
         a.sp c.mar                         ; Get the top of stack's address
         a.pc c.mdr                         ; Save the return address
         a.ir and b.m12 c.pc wr br@fetch    ; Branch to the subroutine's starting point using its address

L1010:   ; ret, esba (establish base address), reba (restore base address), mhw (hardware multiplication), mmc (microcode multiplication)=========================
         a.ir and b.m12 zer@ret		; Determine which operation to perform
         a.ir srl b.1 c.dc cy@esba
         a.dc srl b.1 c.dc cy@reba
         a.dc srl b.1 c.dc cy@mhw
         a.dc srl b.1 c.dc cy@mmc

ret:     a.sp c.mar             ; Read the return address on top of the stack
         rd			; Get the return address
         a.sp add b.1 c.sp      ; Pop return address on top of the stack
         a.mdr c.pc br@fetch	; Replace the address in pc with the return address

esba:    a.sp sub b.1 c.sp     	; Reserve space on the stack
         a.sp c.mar            	; Read top of the stack
         a.fp c.mdr            	; Save the caller's frame pointer
         wr			; Write the caller's frame pointer into the reserved space
         a.sp c.fp br@fetch	; Make the stack and frame pointers be at the same memory location

reba:    a.fp c.sp               ; Copy the frame pointer to the stack pointer
         a.sp c.mar              ; Copy the calling module's address into memory
         a.sp add b.1 c.sp rd    ; Pop the address off the stack and tear down the subroutine's stack frame
         a.mdr c.fp br@fetch     ; Return to the calling module

mhw:     a.sp c.mar                ; Get the top of stack's address
         a.sp add b.1 c.sp rd      ; Read the first operand and pop it
         a.mdr c.temp              ; Save the value into temp
         a.sp c.mar                ; Prepare to read the second operand
         rd                        ; Read the 2nd operand
         a.mdr mul b.temp c.mdr    ; Multiply two operands
         wr br@fetch               ; Replace the top of stack with the product

mmc:     a.sp c.mar                     ; Get the top of stack address
         a.sp add b.1 c.sp rd		; Read the first operand and pop it
         a.mdr c.temp			; Save the value into temp
         a.sp c.mar			; Get the top of stack address
         rd				; Get the second operand (mdr is multiplier)
         a.0 c.ac			; Set the accumulator register to 0
loop:    a.mdr add b.0 zer@done		; If mdr is zero, branch to "done"
         a.mdr and b.1 zer@skip		; If the rightmost bit of mdr is 0, branch to "skip"
         a.temp add b.ac c.ac		; Add two operands
skip:    a.mdr srl b.1 c.mdr		; Shift the first operand right logically one position
         a.temp sll b.1 c.temp br@loop	; Shift the second operand left logically one position
done:    a.ac c.mdr                     ; Move the value in the accumulator (the product) to mdr
         wr br@fetch                    ; Replace the top of stack value with the value in the accumulator

L1011:   ; brp (branch on positive) ==============================================
         a.sp c.mar                    ; Get the top of stack's address
         rd			       ; Read the value
         a.mar c.mdr		       ; Save the branch-to address in mdr to check the condition later
         a.sp add b.1 c.sp	       ; Pop the top of stack
         a.mdr add b.0 !neg@fetch      ; Force the check to see if the condition (the value must be greater than 0) is met
         a.ir and b.m12 c.pc br@fetch  ; Branch to the specified address
 
L1100:   ; br (unconditional branch) ===============================================
         a.ir and b.m12 c.pc br@fetch    ; Extract the address to branch to and branch to it

L1101:   ; brn (branch on negative) ==============================================
         a.sp c.mar                     	; Get the top of stack's address
         rd					; Read the value
         a.mar c.mdr				; Save the branch-to address in mdr to check the condition later
         a.sp add b.1 c.sp			; Pop the top of stack
         a.mdr add b.0 !neg@fetch		; Force the check to see if the condition (the value must be negative) is met
         a.ir and b.m12 c.pc br@fetch		; Branch to the specified address

L1110:   ; brz (branch on zero) ==============================================
         a.sp c.mar                     ; Get the top of stack's address
         a.sp add b.1 c.sp rd		; Read the value on top of stack and pop it
         a.mdr add b.0 !zer@fetch       ; Force the check to see if the condition (the value must be 0) is met
         a.ir and b.m12 c.pc br@fetch	; Branch to the specified address
   
L1111:   ; trap (I/O instructions + halt instruction) =============================================
         br@fetch    ; The simulator handles all trap instructions. Wait until the data has been entered, then fetch a new instruction. If HALT is used, terminate unconditionally



