L101:    a.dc sll b.1 c.dc neg@L1011
         br@L1010

L111:    a.dc sll b.1 c.dc neg@L1111
         br@L1110

         ;=======================================================
         ; Interpret machine instruction

   		 ; Branch instructions
         
L0000:   ; br
         a.ir sext b.m9 c.temp			; sign extend the address in the instruction register, then store it in the temp register
		 								; using the dc (decoder) register lets us process the address and determine if need to branch without changing the original address
	     								; the original address will be used to process other instructions as usual
         a.dc sll b.1 c.dc neg@code1
code0:   a.dc sll b.1 c.dc neg@code01
code00:  a.dc sll b.1 c.dc neg@code001
         br@code000
code1:   a.dc sll b.1 c.dc neg@code11
code10:  a.dc sll b.1 c.dc neg@code101
         br@code100
code01:  a.dc sll b.1 c.dc neg@code011
         br@code010
code11:  a.dc sll b.1 c.dc neg@code111
         br@code110

code000: u !zer@fetch
         a.temp add b.pc c.pc br@fetch
code001: u zer@fetch
         a.temp add b.pc c.pc br@fetch
code010: u !neg@fetch
         a.temp add b.pc c.pc br@fetch
code011: u zer@fetch
         u neg@fetch
         a.temp add b.pc c.pc br@fetch
code100: u ge@fetch 
         a.temp add b.pc c.pc br@fetch
code101: u le@fetch 
         a.temp add b.pc c.pc br@fetch
code110: u !cy@fetch
         a.temp add b.pc c.pc br@fetch
code111: a.temp add b.pc c.pc br@fetch

L0001:   ; add =========================================
         a.ir and b.bit5 !zer@add1
add0:    amux add bmux cmux u br@fetch
add1:    a.ir sext b.m5 c.temp
         amux add b.temp cmux u br@fetch

L0010:   ; ld ==========================================
         a.ir sext b.m9 c.temp
         a.temp add b.pc c.mar
         rd
         a.mdr cmux br@fetch

L0011:   ; st ==========================================
         a.ir sext b.m9 c.temp
         a.temp add b.pc c.mar
         a.ir srl b.3 c.ir
         amux c.mdr
         wr br@fetch

L0100:   ; bl, blr ==========================================
         a.ir and b.m5 zer@blr
bl:      a.ir sext b.m11 c.temp
         a.pc c.lr
         a.temp add b.pc c.pc br@fetch
blr:     a.ir sext b.m6 c.temp
         a.pc c.lr
         amux add b.temp c.pc br@fetch

L0101:   ; and =========================================
         a.ir and b.bit5 !zer@and1
and0:    amux and bmux cmux br@fetch
and1:    a.ir sext b.m5 c.temp u
         amux and b.temp cmux br@fetch

L0110:   ; ldr =========================================
         a.ir sext b.m6 c.temp
         amux add b.temp c.mar
         rd
         a.mdr cmux br@fetch

L0111:   ; str =========================================
         a.ir sext b.m6 c.temp
         amux add b.temp c.mar
         a.ir srl b.3 c.ir
         amux c.mdr
         wr br@fetch

L1000:   ; cmp =========================================
         a.ir and b.bit5 !zer@cmp1
cmp0:    amux sub bmux u br@fetch
cmp1:    a.ir sext b.m5 c.temp
         amux sub b.temp u br@fetch

L1001:   ; not =========================================
         amux not amux cmux u br@fetch

L1010: ; push/pop/srl/sra/sll/rol/ror/mul/div/rem/or/xor/mvr/sext
         a.ir and b.m5 c.dc zer@push
         a.dc sub b.1 c.dc zer@pop
         a.dc sub b.1 c.dc zer@srl
         a.dc sub b.1 c.dc zer@sra
         a.dc sub b.1 c.dc zer@sll
         a.dc sub b.1 c.dc zer@rol
         a.dc sub b.1 c.dc zer@ror
         a.dc sub b.1 c.dc zer@mul
         a.dc sub b.1 c.dc zer@div
         a.dc sub b.1 c.dc zer@rem
         a.dc sub b.1 c.dc zer@or
         a.dc sub b.1 c.dc zer@xor
         a.dc sub b.1 c.dc zer@mvr
         a.dc sub b.1 c.dc zer@sext
         br@fetch

push:    a.ir srl b.3 c.ir
         a.sp sub b.1 c.sp
         a.sp c.mar
         amux c.mdr
         wr br@fetch
         
pop:     a.sp c.mar
         a.sp add b.1 c.sp rd
         a.mdr cmux br@fetch

srl:     a.ir srl b.5 c.temp
         a.ir srl b.3 c.ir
         amux srl b.temp c.temp u
         a.ir sll b.3 c.ir
         a.temp cmux br@fetch

sra:     a.ir srl b.5 c.temp
         a.ir srl b.3 c.ir
         amux sra b.temp c.temp u
         a.ir sll b.3 c.ir
         a.temp cmux br@fetch

sll:     a.ir srl b.5 c.temp
         a.ir srl b.3 c.ir
         amux sll b.temp c.temp u
         a.ir sll b.3 c.ir
         a.temp cmux br@fetch
         
rol:     a.ir srl b.5 c.temp
         a.ir srl b.3 c.ir
         amux rol b.temp c.temp u
         a.ir sll b.3 c.ir
         a.temp cmux br@fetch

ror:     a.ir srl b.5 c.temp
         a.ir srl b.3 c.ir
         amux ror b.temp c.temp u
         a.ir sll b.3 c.ir
         a.temp cmux br@fetch

mul:     amux c.temp
         a.ir srl b.3 c.ir
         amux mul b.temp c.temp
         a.ir sll b.3 c.ir
         a.temp cmux br@fetch
 
div:     amux c.temp
         a.ir srl b.3 c.ir
         amux div b.temp c.temp
         a.ir sll b.3 c.ir
         a.temp cmux br@fetch

rem:     amux c.temp
         a.ir srl b.3 c.ir
         amux rem b.temp c.temp
         a.ir sll b.3 c.ir
         a.temp cmux br@fetch

or:      amux c.temp
         a.ir srl b.3 c.ir
         amux or b.temp c.temp
         a.ir sll b.3 c.ir
         a.temp cmux br@fetch

xor:     amux c.temp
         a.ir srl b.3 c.ir
         amux xor b.temp c.temp
         a.ir sll b.3 c.ir
         a.temp cmux br@fetch

mvr:     amux add b.0 cmux br@fetch

sext:    amux c.temp
         a.ir srl b.3 c.ir
         amux sext b.temp c.temp
         a.ir sll b.3 c.ir
         a.temp cmux br@fetch

L1011:   ; sub =========================================
         a.ir and b.bit5 !zer@sub1
sub0:    amux sub bmux cmux u br@fetch
sub1:    a.ir sext b.m5 c.temp
         amux sub b.temp cmux u br@fetch

L1100:   ; jmp, ret ====================================
         a.ir and b.bit5 !zer@ret
jmp:     a.ir sext b.m6 c.temp
         amux add b.temp c.pc br@fetch
ret:     a.lr c.pc br@fetch

L1101:   ; mvi =========================================
         a.ir sext b.m9 cmux br@fetch

L1110:   ; lea =========================================
         a.ir sext b.m9 c.temp
         a.pc add b.temp cmux br@fetch

L1111:   ; trap ========================================
         br@fetch
