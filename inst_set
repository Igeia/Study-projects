;        Stack Instruction Set                   s.sm

         ;===================================================
         ; Fetch machine instruction, increment pc
fetch:   a.pc c.mar 
         a.pc add b.1 c.pc rd

         ;===================================================
         ; Decode instruction
         
; How to proceed:
; 1) Analyze the first bit by adding 0 to it. If the n (negative) flag is 1, set the 1st bit to 1 and jump to L1; else execute the next instruction;
; 2) Shift left logically by 1 bit the next bit in the opcode from the instruction register;
; 3) Analyze the shifted out bit. If it's 1, set the bit to 1 and jump to the next label; else execute the next instruction;
; 4) Repeat steps 2 and 3 until the analysis of all 4 bits is complete.
; We are done: all 4 bits are decoded, we can now execute the appropriate machine instruction.

         a.mdr add b.0 c.ir neg@L1
L0:      a.ir sll b.1 c.dc neg@L01
L00:     a.dc sll b.1 c.dc neg@L001
L000:    a.dc sll b.1 c.dc neg@L0001
         br@L0000

L1:      a.ir sll b.1 c.dc neg@L11
L10:     a.dc sll b.1 c.dc neg@L101
L100:    a.dc sll b.1 c.dc neg@L1001
         br@L1000

L01:     a.dc sll b.1 c.dc neg@L011
L010:    a.dc sll b.1 c.dc neg@L0101
         br@L0100

L11:     a.dc sll b.1 c.dc neg@L111
L110:    a.dc sll b.1 c.dc neg@L1101
         br@L1100

L001:    a.dc sll b.1 c.dc neg@L0011
         br@L0010

L011:    a.dc sll b.1 c.dc neg@L0111
         br@L0110

L101:    a.dc sll b.1 c.dc neg@L1011
         br@L1010

L111:    a.dc sll b.1 c.dc neg@L1111
         br@L1110

         ;===================================================
         ; Interpret machine instruction
         
L0000:   ; p (push) ================================================
         a.ir and b.m12 c.mar    ; extract data from instruction, prepare to read from memory
         rd                      ; read data from memory address
         a.sp sub b.1 c.sp       ; decrement stack pointer
         a.sp c.mar              ; prepare to write to the top of stack
         wr                      ; push immediate value on top of stack
         a.mdr c.mar br@fetch    ; write data in mdr to the address in mar

L0001:   ; pi (push immediate) ===============================================
         a.ir and b.m12 c.mar    ; extract immediate value (or address if using labels) from machine instruction
         a.mar c.mdr             ; store immediate value/address in mdr for now
         a.sp sub b.1 c.sp       ; decrement stack pointer
         a.sp c.mar              ; prepare to write to the top of stack
         wr                      ; start write operation
         a.mdr c.mar br@fetch    ; push immediate value/address onto the stack
          
L0010:   ; pr (push relative) ===============================================
         a.ir sext b.m12 c.mar    ; sign extend address
         a.mar c.mdr              ; store address in mdr
         a.fp add b.mdr c.mdr     ; update mdr considering frame pointer's location
         a.mdr c.mar              ; update top of stack
         rd                       ; read data
         a.sp sub b.1 c.sp        ; decrement sp
         a.sp c.mar               ; instructions 7-8: read top of stack and write to it
         wr br@fetch

L0011:   ; cora (convert relative address) =============================================
         a.ir sext b.m12 c.mar    ; sign extend address in machine instruction
         a.mar c.mdr              ; store relative address in mdr
         a.fp add b.mdr c.mdr     ; convert to absolute address by adding frame pointer and address in mdr
         a.mdr c.mar              ; update address
         a.sp sub b.1 c.sp        ; decrement sp
         a.sp c.mar               ; instructions 6-7: read top of stack and write data at absolute address to it
         wr br@fetch

L0100:   ; stav (store value at address) =============================================
         a.sp c.mar              ; read value on top of stack
         a.sp add b.1 c.sp rd    ; pop stack into mdr and save in temp
         a.mdr c.temp
         a.sp c.mar              ; read address on top of stack
         a.sp add b.1 c.sp rd 
         a.mdr c.mar
         a.temp c.mdr            ; store value at address specified in mdr and write data to it
         wr br@fetch
         
L0101:   ; dp (dereference pointer) ===============================================
         a.sp c.mar    ; read address on top of stack
         rd
         a.mdr c.mar   ; read value the pointer points to
         rd
         a.sp c.mar    ; dereference pointer and replace it with the value it points to onto stack
         wr br@fetch

L0110:   ; asp (add to stack pointer) ==============================================
         a.ir sext b.m12 c.mar           ; sign extend data from machine instruction
         a.mar c.mdr                     ; place value inside mdr
         a.sp add b.mdr c.sp br@fetch    ; add value (positive or negative) to sp
          
L0111:   ; add ==============================================
         a.sp c.mar                ; read the address on top of stack into mar
         a.sp add b.1 c.sp rd      ; read the 1st operand
         a.mdr c.temp              ; save it in temp
         a.sp c.mar                ; read the 2nd operand
         rd
         a.mdr add b.temp c.mdr    ; add two operands, save into mdr, and rewrite the top of stack
         wr br@fetch

L1000:   ; sub ==============================================
         a.sp c.mar                ; read the address on top of stack into mar
         a.sp add b.1 c.sp rd      ; read the 1st operand
         a.mdr c.temp              ; save it in temp
         a.sp c.mar                ; read the 2nd operand
         rd
         a.mdr sub b.temp c.mdr    ; sub two operands, save into mdr, and rewrite the top of stack
         wr br@fetch

L1001:   ; call =============================================
         a.sp sub b.1 c.sp                  ; decrement sp
         a.sp c.mar                         ; read top of stack
         a.pc c.mdr                         ; save next machine instruction's address to mdr
         a.ir and b.m12 c.pc wr br@fetch    ; write the subroutine's start address into pc and branch to it

L1010:   ; ret, esba (establish base address), reba (restore base address), mhw (hardware multiplication), mmc (microcode multiplication)=========================
         a.ir and b.m12 zer@ret
         a.ir srl b.1 c.dc cy@esba
         a.dc srl b.1 c.dc cy@reba
         a.dc srl b.1 c.dc cy@mhw
         a.dc srl b.1 c.dc cy@mmc

ret:     a.sp c.mar             ; read the top of stack
         rd
         a.sp add b.1 c.sp      ; pop return address on top of stack into pc
         a.mdr c.pc br@fetch

esba:    a.sp sub b.1 c.sp     ; decrement sp
         a.sp c.mar            ; read top of stack
         a.fp c.mdr            ; save the caller's frame pointer and write to memory
         wr
         a.sp c.fp br@fetch    ; caller's fp is now on top of stack

reba:    a.fp c.sp               ; copy frame pointer to sp
         a.sp c.mar              ; copy the calling module's address into memory
         a.sp add b.1 c.sp rd    ; pop the address off the stack
         a.mdr c.fp br@fetch     ; return to the calling module's frame pointer

mhw:     a.sp c.mar                ; get address of top of stack into mar
         a.sp add b.1 c.sp rd      ; read top of stack and increment sp
         a.mdr c.temp              ; copy in temp
         a.sp c.mar                ; prepare to read 2nd operand, don't increment sp
         rd                        ; read 2nd operand into mdr
         a.mdr mul b.temp c.mdr    ; multiply, put sum in mdr
         wr br@fetch               ; replace top of stack with sum in mdr

mmc:     a.sp c.mar                       ; pop stack into temp (temp is multiplicand)
         a.sp add b.1 c.sp rd
         a.mdr c.temp
         a.sp c.mar                       ; pop stack into mdr (mdr is multiplier)
         rd
         a.0 c.ac                         ; set ac to 0
loop:    a.mdr add b.0 zer@done           ; if mdr = 0 branch to done
         a.mdr and b.1 zer@skip           ; if rightmost bit of mdr = 0 branch to skip
         a.temp add b.ac c.ac             ; add temp to ac
skip:    a.mdr srl b.1 c.mdr              ; shift mdr right logically one position
         a.temp sll b.1 c.temp br@loop    ; shift temp left logically one position
done:    a.ac c.mdr                       ; push ac (the product) to mdr
         wr br@fetch                      ; replace top of stack with value in ac

L1011:   ; brp (branch on positive) ==============================================
         a.sp c.mar                      ; read top of stack and save address to mdr
         rd
         a.mar c.mdr
         a.sp add b.1 c.sp               ; increment sp
         a.mdr add b.0 !neg@fetch        ; if mdr >= 0 branch to fetch, else branch to specified address
         a.ir and b.m12 c.pc br@fetch
 
L1100:   ; br (unconditional branch) ===============================================
         a.ir and b.m12 c.pc br@fetch    ; extract branch-to address and load pc with it

L1101:   ; brn (branch on negative) ==============================================
         a.sp c.mar                      ; read top of stack and save address to mdr
         rd
         a.mar c.mdr
         a.sp add b.1 c.sp               ; increment sp
         a.mdr add b.0 !neg@fetch        ; if mdr >= 0 branch to fetch, else branch to specified address
         a.ir and b.m12 c.pc br@fetch

L1110:   ; brz (branch on zero) ==============================================
         a.sp c.mar                      ; pop top of stack and read its value
         a.sp add b.1 c.sp rd
         a.mdr add b.0 !zer@fetch        ; if mdr is not 0 branch to fetch, else branch to address
         a.ir and b.m12 c.pc br@fetch
   
L1111:   ; trap (I/O instructions + halt instruction) =============================================
         br@fetch    ; The simulator handles all trap instructions. Wait until the data has been entered, then fetch a new instruction. If HALT is used, terminate unconditionally



